# Copia a .env.local (desarrollo) y repite las mismas variables en
# Vercel → Settings → Environment Variables. NUNCA subas .env.local a GitHub.

# --- Facebook (developers.facebook.com → tu app → Configuración → Básica)
FB_APP_ID=
FB_APP_SECRET=
NEXT_PUBLIC_FB_APP_ID=
# Opcional: versión de la Graph API (por defecto v23.0)
# NEXT_PUBLIC_GRAPH_VERSION=v23.0
# Opcional: URL pública de la app (ej. https://mi-app.vercel.app). Si se omite se usa el dominio de la petición.
# NEXT_PUBLIC_APP_URL=

# --- Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Secretos propios (genéralos tú)
# ENCRYPTION_KEY: 64 caracteres hex  ->  openssl rand -hex 32
ENCRYPTION_KEY=
# SESSION_SECRET: opcional (si no existe se usa ENCRYPTION_KEY)  ->  openssl rand -hex 32
SESSION_SECRET=
# CRON_SECRET: lo que cron-job.org enviará en el header Authorization: Bearer <CRON_SECRET>  ->  openssl rand -hex 24
CRON_SECRET=
# Contraseña del panel /admin
ADMIN_PASSWORD=
