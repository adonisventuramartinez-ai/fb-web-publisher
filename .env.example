# Copia este archivo a .env.local para desarrollo local,
# y agrega estas mismas variables en Vercel (Settings -> Environment Variables)

# App ID y App Secret de tu app de Facebook (developers.facebook.com)
FB_APP_ID=tu_app_id_aqui
FB_APP_SECRET=tu_app_secret_aqui

# El mismo App ID pero visible en el navegador (Next.js requiere el prefijo NEXT_PUBLIC_ para eso)
NEXT_PUBLIC_FB_APP_ID=tu_app_id_aqui
