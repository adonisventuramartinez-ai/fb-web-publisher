{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/cron": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/cron",
      "dest": "/api/cron",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS"
      }
    }
  ]
}
